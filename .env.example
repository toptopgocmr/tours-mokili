APP_NAME="Smart Solar Energy Africa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ssea
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=public

QUEUE_CONNECTION=sync
CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=localhost

# Devis / Facture
SSEA_DEVISE=FCFA
SSEA_TAUX_TVA=18
SSEA_ENTREPRISE_NOM="Smart Solar Energy Africa"
SSEA_ENTREPRISE_ADRESSE="Abidjan, Côte d'Ivoire"
SSEA_ENTREPRISE_TEL="+225 00 00 00 00"
SSEA_ENTREPRISE_EMAIL="contact@smartsolarenergyafrica.com"

# --- Paiements Mobile Money (collecte + decaissement) - voir config/payments.php ---
# Webhooks a declarer : ${APP_URL}/api/webhooks/payments/{peex|pawapay|maishapay|digitwace}
PAYMENT_DEFAULT_GATEWAY=peex
PEEX_PAYOUT_PATH=clients/request_payment
PEEX_WEBHOOK_SECRET=

PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_CUSTOMER_MESSAGE="MOKILI TOUR"

# MaishaPay (Web API v2.1) - production : MAISHAPAY_GATEWAY_MODE=1 + cles MP-LIVE...
MAISHAPAY_GATEWAY_MODE=0
MAISHAPAY_PUBLIC_KEY=
MAISHAPAY_SECRET_KEY=
MAISHAPAY_WEBHOOK_SECRET=
MAISHAPAY_AMOUNT_MULTIPLIER=1

DIGITWACE_BASE_URL=
DIGITWACE_API_KEY=
DIGITWACE_API_SECRET=
DIGITWACE_COLLECT_PATH=/api/v1/payments/collect
DIGITWACE_PAYOUT_PATH=/api/v1/payments/payout
DIGITWACE_STATUS_PATH=/api/v1/payments/{reference}
DIGITWACE_WEBHOOK_SECRET=

# --- Vols (billetterie aerienne) ---
FLIGHTS_MARGIN_PERCENT=8
FLIGHTS_OFFER_TTL=20
FLIGHTS_MAX_ATTEMPTS=3
FLIGHTS_MAX_ORDER_AMOUNT=0
# Scenarios du fournisseur simule (jamais en production)
FLIGHTS_FAKE_FAIL_BOOKING=false
FLIGHTS_FAKE_FAIL_TICKETING=false
FLIGHTS_FAKE_TIMEOUT_AFTER_TICKETING=false
FLIGHTS_FAKE_PRICE_CHANGE=0

# --- Amadeus Self-Service (https://developers.amadeus.com) ---
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_CURRENCY=XAF
AMADEUS_TICKETING_OPTION=DELAY_TO_CANCEL
AMADEUS_TICKETING_DELAY=6D
# Suivi de vol (retards / annulations)
FLIGHTS_TRACKING_PROVIDERS=amadeus,aviationstack
AVIATIONSTACK_KEY=
