APP_NAME="MOKILI TOUR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mokili_tour
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# --- Peex API (https://peex-api-docs.peexit.com) ---
PEEX_ENV=sandbox
PEEX_SANDBOX_BASE_URL=https://sandbox.peexit.com/api/v1/
PEEX_PRODUCTION_BASE_URL=https://server.peexit.com/api/v1/
PEEX_SANDBOX_KEY=
PEEX_PRODUCTION_KEY=
PEEX_TIMEOUT=15

# --- Social sign-in (Google / Facebook / Instagram) ---
# Register an app with each provider and whitelist this redirect URI:
#   {APP_URL}/api/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Custom URL scheme the Flutter app listens on for the OAuth redirect
# (see mobile-mokili/android/.../AndroidManifest.xml + ios/.../Info.plist).
MOBILE_APP_SCHEME=mokilitour

# --- Phone/OTP sign-in ---
# "log" (default) writes the SMS code to the Laravel log instead of
# sending a real text - fine for testing, not for production. Wire a
# real provider in App\Services\Sms (Twilio, Africa's Talking, Orange
# SMS API, ...) and switch this once one is chosen.
SMS_GATEWAY=log

# --- Paiements Mobile Money (collecte + decaissement) - voir config/payments.php ---
# Webhooks a declarer : ${APP_URL}/api/webhooks/payments/{peex|pawapay|maishapay|digitwace}
PAYMENT_DEFAULT_GATEWAY=peex
PEEX_PAYOUT_PATH=clients/request_payment
PEEX_WEBHOOK_SECRET=

PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_CUSTOMER_MESSAGE="MOKILI TOUR"

# MaishaPay (Web API v2.1) - production : MAISHAPAY_GATEWAY_MODE=1 + cles MP-LIVE...
MAISHAPAY_GATEWAY_MODE=0
MAISHAPAY_PUBLIC_KEY=
MAISHAPAY_SECRET_KEY=
MAISHAPAY_WEBHOOK_SECRET=
MAISHAPAY_AMOUNT_MULTIPLIER=1

DIGITWACE_BASE_URL=
DIGITWACE_API_KEY=
DIGITWACE_API_SECRET=
DIGITWACE_COLLECT_PATH=/api/v1/payments/collect
DIGITWACE_PAYOUT_PATH=/api/v1/payments/payout
DIGITWACE_STATUS_PATH=/api/v1/payments/{reference}
DIGITWACE_WEBHOOK_SECRET=
