APP_NAME="MOKILI TOUR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mokili_tour
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# --- Peex API (https://peex-api-docs.peexit.com) ---
PEEX_ENV=sandbox
PEEX_SANDBOX_BASE_URL=https://sandbox.peexit.com/api/v1/
PEEX_PRODUCTION_BASE_URL=https://server.peexit.com/api/v1/
PEEX_SANDBOX_KEY=
PEEX_PRODUCTION_KEY=
PEEX_TIMEOUT=15
